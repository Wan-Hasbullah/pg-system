<script>
  // ─── CONFIG ───────────────────────────────────────────────────────
  const SHEET_CSV_URL = 'https://script.google.com/macros/s/AKfycbwqegXJIbEIvJwVI0UEWasWA5t_hF1BzCW3LTSFJh0haohGzbZ6BV_Ik5dfKRtijuScrw/exec';

  let faqData = [];
  let isTyping = false;
  let dataLoaded = false;

  // ─── UTILITIES ────────────────────────────────────────────────────
  function now() {
    return new Date().toLocaleTimeString('ms-MY', { hour: '2-digit', minute: '2-digit' });
  }

  function scrollBottom() {
    const m = document.getElementById('messages');
    setTimeout(() => m.scrollTo({ top: m.scrollHeight, behavior: 'smooth' }), 80);
  }

  // ─── CSV PARSER (selamat untuk data berkoma & berquote) ───────────
  function parseCSV(text) {
    const rows = [];
    const lines = text.trim().split('\n');
    for (const line of lines) {
      const cols = [];
      let cur = '';
      let inQuote = false;
      for (let i = 0; i < line.length; i++) {
        const ch = line[i];
        if (ch === '"') {
          if (inQuote && line[i + 1] === '"') { cur += '"'; i++; }
          else { inQuote = !inQuote; }
        } else if (ch === ',' && !inQuote) {
          cols.push(cur.trim()); cur = '';
        } else {
          cur += ch;
        }
      }
      cols.push(cur.trim());
      rows.push(cols);
    }
    return rows;
  }

  // ─── LOAD FAQ DATA ────────────────────────────────────────────────
  async function loadFAQ() {
    try {
      const res = await fetch(SHEET_CSV_URL);
      const text = await res.text();
      const rows = parseCSV(text);
      const dataRows = rows.slice(1); // skip header
      faqData = dataRows.map(cols => ({
        tajuk: (cols[1] || '').trim(),
        huraian: (cols[2] || '').trim()
      })).filter(d => d.tajuk && d.huraian);
      dataLoaded = true;
      showSuggestions();
    } catch (e) {
      console.warn('Gagal memuatkan data FAQ:', e);
      dataLoaded = true;
    }
  }

  // ─── SEARCH ───────────────────────────────────────────────────────
  function searchFAQ(query) {
    if (!query || faqData.length === 0) return [];
    const q = query.toLowerCase().replace(/[^a-z0-9 ]/gi, '');
    const words = q.split(' ').filter(w => w.length > 2);

    const scored = faqData.map(item => {
      const haystack = (item.tajuk + ' ' + item.huraian).toLowerCase();
      let score = 0;
      if (haystack.includes(q)) score += 10;
      words.forEach(w => { if (haystack.includes(w)) score += 2; });
      return { ...item, score };
    }).filter(i => i.score > 0);

    return scored.sort((a, b) => b.score - a.score).slice(0, 3);
  }

  // ─── RENDER HELPERS ───────────────────────────────────────────────
  function addTyping() {
    removeTyping();
    const div = document.createElement('div');
    div.className = 'typing-indicator';
    div.id = 'typingIndicator';
    div.innerHTML = `
      <img src="https://blogger.googleusercontent.com/img/a/AVvXsEjH8kKw3_SWdf96cjqIx_j4exadqr0togYGxXJxWA8D7z40VpkkLeyeyRDrZRCdVXdKPA2LuOtxXZ-eRffWfnM0_UPa6g7KGkCLAx0Br1DoJO3MC3P7jZXg6EZ3FsL0zdiI-RRzcf9ArG87YT4WvpQ5V1PEpe7kCQc0C3SePyxBo5ONOFkmAgYKXDOFTyo=s16000" class="msg-avatar">
      <div class="typing-bubble">
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
      </div>`;
    document.getElementById('messages').appendChild(div);
    scrollBottom();
  }

  function removeTyping() {
    const t = document.getElementById('typingIndicator');
    if (t) t.remove();
  }

  function addBotBubble(text, skipAvatar = false) {
    const msgs = document.getElementById('messages');
    const row = document.createElement('div');
    row.className = 'msg-row bot';
    row.innerHTML = `
      <img src="https://blogger.googleusercontent.com/img/a/AVvXsEjH8kKw3_SWdf96cjqIx_j4exadqr0togYGxXJxWA8D7z40VpkkLeyeyRDrZRCdVXdKPA2LuOtxXZ-eRffWfnM0_UPa6g7KGkCLAx0Br1DoJO3MC3P7jZXg6EZ3FsL0zdiI-RRzcf9ArG87YT4WvpQ5V1PEpe7kCQc0C3SePyxBo5ONOFkmAgYKXDOFTyo=s16000" class="msg-avatar ${skipAvatar ? 'hidden' : ''}">
      <div class="bubble-wrap">
        <div class="bubble bot">
          ${!skipAvatar ? '<span class="sender">Pembantu WH</span>' : ''}
          ${text}
          <span class="time">${now()}</span>
        </div>
      </div>`;
    msgs.appendChild(row);
    scrollBottom();
  }

  function addUserBubble(text) {
    const msgs = document.getElementById('messages');
    const row = document.createElement('div');
    row.className = 'msg-row user';
    row.innerHTML = `
      <div class="bubble-wrap">
        <div class="bubble user">
          ${text}
          <span class="time">${now()} ✓✓</span>
        </div>
      </div>`;
    msgs.appendChild(row);
    scrollBottom();
  }

  function addFAQResult(item) {
    const msgs = document.getElementById('messages');
    const wrap = document.createElement('div');
    wrap.style.display = 'flex';
    wrap.style.gap = '8px';
    wrap.style.alignItems = 'flex-end';

    const img = document.createElement('img');
    img.src = 'https://blogger.googleusercontent.com/img/a/AVvXsEjH8kKw3_SWdf96cjqIx_j4exadqr0togYGxXJxWA8D7z40VpkkLeyeyRDrZRCdVXdKPA2LuOtxXZ-eRffWfnM0_UPa6g7KGkCLAx0Br1DoJO3MC3P7jZXg6EZ3FsL0zdiI-RRzcf9ArG87YT4WvpQ5V1PEpe7kCQc0C3SePyxBo5ONOFkmAgYKXDOFTyo=s16000';
    img.className = 'msg-avatar';

    const card = document.createElement('div');
    card.className = 'faq-card';
    card.innerHTML = `
      <div class="faq-card-label">Rekod FAQ Dijumpai</div>
      <div class="faq-card-title">${escHtml(item.tajuk)}</div>
      <div class="faq-card-body">${escHtml(item.huraian)}</div>
      <div class="faq-card-time">${now()}</div>`;

    wrap.appendChild(img);
    wrap.appendChild(card);
    msgs.appendChild(wrap);
    scrollBottom();
  }

  function addNotFound() {
    const msgs = document.getElementById('messages');
    const wrap = document.createElement('div');
    wrap.style.display = 'flex';
    wrap.style.gap = '8px';
    wrap.style.alignItems = 'flex-end';

    const img = document.createElement('img');
    img.src = 'https://blogger.googleusercontent.com/img/a/AVvXsEjH8kKw3_SWdf96cjqIx_j4exadqr0togYGxXJxWA8D7z40VpkkLeyeyRDrZRCdVXdKPA2LuOtxXZ-eRffWfnM0_UPa6g7KGkCLAx0Br1DoJO3MC3P7jZXg6EZ3FsL0zdiI-RRzcf9ArG87YT4WvpQ5V1PEpe7kCQc0C3SePyxBo5ONOFkmAgYKXDOFTyo=s16000';
    img.className = 'msg-avatar';

    const card = document.createElement('div');
    card.className = 'notfound-bubble';
    card.innerHTML = `
      <div class="notfound-title">Pertanyaan anda tiada dalam simpanan saya. Anda boleh rujuk Encik Wan Hasbullah di sini:</div>
      <a href="https://wa.me/601126704897" class="wa-btn" target="_blank">
        <svg fill="white" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
