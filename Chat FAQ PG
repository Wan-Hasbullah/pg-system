    wrap.appendChild(img);
    wrap.appendChild(card);
    msgs.appendChild(wrap);
    scrollBottom();
  }

  function escHtml(str) {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  // ─── SUGGESTIONS ──────────────────────────────────────────────────
  function showSuggestions() {
    const container = document.getElementById('suggestions');
    container.innerHTML = '';
    const samples = faqData.slice(0, 4);
    if (samples.length === 0) return;
    samples.forEach(item => {
      const pill = document.createElement('button');
      pill.className = 'suggestion-pill visible';
      const label = item.tajuk.length > 35 ? item.tajuk.slice(0, 35) + '...' : item.tajuk;
      pill.textContent = label;
      pill.onclick = () => {
        document.getElementById('userInput').value = item.tajuk;
        sendMessage();
      };
      container.appendChild(pill);
    });
  }

  // ─── SEND MESSAGE ─────────────────────────────────────────────────
  async function sendMessage() {
    const input = document.getElementById('userInput');
    const query = input.value.trim();
    if (!query || isTyping) return;

    isTyping = true;
    input.value = '';
    input.focus();

    addUserBubble(escHtml(query));
    addTyping();

    await new Promise(r => setTimeout(r, 900 + Math.random() * 600));
    removeTyping();

    const results = searchFAQ(query);

    if (results.length > 0) {
      addBotBubble(`Saya jumpa <strong>${results.length}</strong> rekod berkaitan pertanyaan anda:`);
      for (let i = 0; i < results.length; i++) {
        await new Promise(r => setTimeout(r, i * 300));
        addFAQResult(results[i]);
      }
    } else {
      addNotFound();
    }

    isTyping = false;
  }

  // ─── KEYBOARD ─────────────────────────────────────────────────────
  document.getElementById('userInput').addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });

  // ─── WELCOME MESSAGE (TYPING EFFECT) ─────────────────────────────
  async function welcomeMessage() {
    const welcomeText = 'Assalamualaikum, Hai. Saya pembantu Encik Wan Hasbullah. Anda ingin bertanya tentang apa?';

    addTyping();
    await new Promise(r => setTimeout(r, 1400));
    removeTyping();

    const msgs = document.getElementById('messages');
    const row = document.createElement('div');
    row.className = 'msg-row bot';
    row.innerHTML = `
      <img src="https://blogger.googleusercontent.com/img/a/AVvXsEjH8kKw3_SWdf96cjqIx_j4exadqr0togYGxXJxWA8D7z40VpkkLeyeyRDrZRCdVXdKPA2LuOtxXZ-eRffWfnM0_UPa6g7KGkCLAx0Br1DoJO3MC3P7jZXg6EZ3FsL0zdiI-RRzcf9ArG87YT4WvpQ5V1PEpe7kCQc0C3SePyxBo5ONOFkmAgYKXDOFTyo=s16000" class="msg-avatar">
      <div class="bubble-wrap">
        <div class="bubble bot">
          <span class="sender">Pembantu WH</span>
          <span id="welcomeTyped"></span><span id="cursor" style="animation:blink 0.8s step-end infinite">▎</span>
          <span class="time" id="welcomeTime" style="display:none">${now()}</span>
        </div>
      </div>`;
    msgs.appendChild(row);
    scrollBottom();

    const typed = document.getElementById('welcomeTyped');
    const cur = document.getElementById('cursor');

    for (let i = 0; i <= welcomeText.length; i++) {
      typed.textContent = welcomeText.slice(0, i);
      scrollBottom();
      await new Promise(r => setTimeout(r, 28));
    }

    cur.remove();
    document.getElementById('welcomeTime').style.display = 'block';
    scrollBottom();

    loadFAQ();
  }

  // ─── INIT ─────────────────────────────────────────────────────────
  setTimeout(welcomeMessage, 600);
</script>

