<!DOCTYPE html>
<html lang="ms">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chat FAQ - Wan Hasbullah</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Sora:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --primary: #0A2342;
    --primary-mid: #1B3E6E;
    --accent: #00B4D8;
    --accent-light: #90E0EF;
    --accent-glow: rgba(0,180,216,0.15);
    --gold: #F4A800;
    --surface: #F0F4FA;
    --surface2: #E4EAF5;
    --card: #FFFFFF;
    --bubble-bot: #FFFFFF;
    --bubble-user: linear-gradient(135deg, #00B4D8 0%, #0077B6 100%);
    --text: #0A1628;
    --text-muted: #5A6B85;
    --text-light: #9AAEC4;
    --border: rgba(0,60,120,0.1);
    --border-accent: rgba(0,180,216,0.25);
    --radius: 20px;
    --shadow: 0 4px 24px rgba(10,35,66,0.08);
    --header-h: 72px;
    --input-h: 80px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  html, body {
    height: 100%;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--surface);
    color: var(--text);
    overflow: hidden;
  }

  .app {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    max-width: 760px;
    margin: 0 auto;
    position: relative;
  }

  /* ─── HEADER ─── */
  .header {
    flex-shrink: 0;
    height: var(--header-h);
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-mid) 100%);
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    gap: 14px;
    z-index: 10;
    position: relative;
    box-shadow: 0 2px 20px rgba(10,35,66,0.2);
  }

  .header::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,180,216,0.4), transparent);
  }

  .avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 2.5px solid var(--accent-light);
    display: block;
  }

  .status-dot {
    position: absolute;
    bottom: 1px;
    right: 1px;
    width: 11px;
    height: 11px;
    background: #2ECC71;
    border: 2px solid var(--primary);
    border-radius: 50%;
  }

  .header-info { flex: 1; }

  .header-name {
    font-family: 'Sora', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: white;
    letter-spacing: -0.01em;
  }

  .header-status {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    margin-top: 1px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .header-status::before {
    content: '';
    width: 6px;
    height: 6px;
    background: #2ECC71;
    border-radius: 50%;
    display: inline-block;
  }

  .header-actions {
    display: flex;
    gap: 8px;
  }

  .header-btn {
    width: 38px;
    height: 38px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }

  .header-btn:hover { background: rgba(255,255,255,0.18); }
  .header-btn svg { width: 18px; height: 18px; }

  /* ─── MESSAGES AREA ─── */
  .messages {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 10px;
    scroll-behavior: smooth;
  }

  .messages::-webkit-scrollbar { width: 4px; }
  .messages::-webkit-scrollbar-track { background: transparent; }
  .messages::-webkit-scrollbar-thumb { background: var(--surface2); border-radius: 2px; }

  .date-divider {
    text-align: center;
    font-size: 11px;
    color: var(--text-light);
    font-weight: 500;
    letter-spacing: 0.05em;
    padding: 4px 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .date-divider::before, .date-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .msg-row {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    animation: msgIn 0.25s ease forwards;
    opacity: 0;
    transform: translateY(8px);
  }

  @keyframes msgIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .msg-row.bot { justify-content: flex-start; }
  .msg-row.user { justify-content: flex-end; }

  .msg-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    border: 1.5px solid var(--border-accent);
    flex-shrink: 0;
    margin-bottom: 2px;
  }

  .msg-avatar.hidden { opacity: 0; pointer-events: none; }

  .bubble-wrap { display: flex; flex-direction: column; max-width: 75%; }
  .msg-row.user .bubble-wrap { align-items: flex-end; }

  .bubble {
    padding: 0.75rem 1rem;
    border-radius: 18px;
    font-size: 14.5px;
    line-height: 1.65;
    position: relative;
    word-break: break-word;
  }

  .bubble.bot {
    background: var(--bubble-bot);
    color: var(--text);
    border: 1px solid var(--border);
    border-bottom-left-radius: 6px;
    box-shadow: 0 2px 10px rgba(10,35,66,0.06);
  }

  .bubble.user {
    background: var(--bubble-user);
    color: white;
    border-bottom-right-radius: 6px;
    box-shadow: 0 4px 16px rgba(0,119,182,0.3);
  }

  .bubble.bot .sender {
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    display: block;
    margin-bottom: 4px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .bubble .time {
    font-size: 10.5px;
    color: var(--text-light);
    margin-top: 4px;
    display: block;
    text-align: right;
  }

  .bubble.user .time { color: rgba(255,255,255,0.6); }

  /* ─── FAQ RESULT CARD ─── */
  .faq-card {
    background: white;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 14px;
    border-top-left-radius: 6px;
    padding: 0.875rem 1rem;
    max-width: 78%;
    box-shadow: 0 2px 12px rgba(10,35,66,0.06);
    animation: msgIn 0.25s ease forwards;
    opacity: 0;
    transform: translateY(8px);
  }

  .faq-card-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .faq-card-label::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
  }

  .faq-card-title {
    font-family: 'Sora', sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 6px;
    line-height: 1.4;
  }

  .faq-card-body {
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .faq-card-time {
    font-size: 10px;
    color: var(--text-light);
    margin-top: 8px;
    text-align: right;
  }

  /* ─── TYPING INDICATOR ─── */
  .typing-indicator {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    animation: msgIn 0.25s ease forwards;
    opacity: 0;
    transform: translateY(8px);
  }

  .typing-bubble {
    background: white;
    border: 1px solid var(--border);
    border-radius: 18px;
    border-bottom-left-radius: 6px;
    padding: 0.875rem 1rem;
    display: flex;
    align-items: center;
    gap: 5px;
    box-shadow: 0 2px 10px rgba(10,35,66,0.06);
  }

  .typing-dot {
    width: 7px;
    height: 7px;
    background: var(--accent-light);
    border-radius: 50%;
    animation: typingPulse 1.2s ease-in-out infinite;
  }

  .typing-dot:nth-child(2) { animation-delay: 0.15s; }
  .typing-dot:nth-child(3) { animation-delay: 0.3s; }

  @keyframes typingPulse {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-5px); opacity: 1; }
  }

  /* ─── SUGGESTIONS ─── */
  .suggestions {
    padding: 0 1.25rem 0.75rem;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    flex-shrink: 0;
  }

  .suggestions::-webkit-scrollbar { display: none; }

  .suggestion-pill {
    flex-shrink: 0;
    background: white;
    border: 1.5px solid var(--border-accent);
    border-radius: 50px;
    padding: 6px 14px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--primary-mid);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
    display: none;
  }

  .suggestion-pill.visible { display: block; }
  .suggestion-pill:hover { background: var(--accent-glow); border-color: var(--accent); color: var(--accent); }

  /* ─── INPUT BAR ─── */
  .input-bar {
    flex-shrink: 0;
    background: white;
    border-top: 1px solid var(--border);
    padding: 0.875rem 1rem;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 -4px 20px rgba(10,35,66,0.05);
  }

  .input-wrap {
    flex: 1;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: 50px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    transition: all 0.2s;
    gap: 8px;
  }

  .input-wrap:focus-within {
    border-color: var(--accent);
    background: white;
    box-shadow: 0 0 0 4px var(--accent-glow);
  }

  .input-wrap svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--text-light); }

  #userInput {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14.5px;
    color: var(--text);
    padding: 0.625rem 0;
    min-width: 0;
  }

  #userInput::placeholder { color: var(--text-light); }

  .send-btn {
    width: 46px;
    height: 46px;
    background: linear-gradient(135deg, var(--accent) 0%, #0077B6 100%);
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s;
    box-shadow: 0 4px 14px rgba(0,180,216,0.3);
  }

  .send-btn:hover { transform: scale(1.05); box-shadow: 0 6px 20px rgba(0,180,216,0.4); }
  .send-btn:active { transform: scale(0.96); }
  .send-btn svg { width: 18px; height: 18px; }

  /* ─── NOT FOUND BUBBLE ─── */
  .notfound-bubble {
    background: white;
    border: 1px solid rgba(244,168,0,0.25);
    border-left: 3px solid var(--gold);
    border-radius: 14px;
    border-top-left-radius: 6px;
    padding: 0.875rem 1rem;
    max-width: 78%;
    box-shadow: 0 2px 12px rgba(10,35,66,0.06);
    animation: msgIn 0.25s ease forwards;
    opacity: 0;
    transform: translateY(8px);
  }

  .notfound-title {
    font-size: 13.5px;
    color: var(--text);
    line-height: 1.65;
    margin-bottom: 10px;
  }

  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #25D366;
    color: white;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .wa-btn:hover { background: #1ebe5a; transform: translateY(-1px); }
  .wa-btn svg { width: 16px; height: 16px; }

  .notfound-time {
    font-size: 10px;
    color: var(--text-light);
    margin-top: 8px;
    text-align: right;
  }

  @media (max-width: 480px) {
    .bubble { max-width: 85%; font-size: 14px; }
    .faq-card, .notfound-bubble { max-width: 88%; }
  }
</style>
</head>
